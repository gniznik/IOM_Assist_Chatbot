# Copy this file to .env and fill in your actual values

# n8n webhook URL for your RAG workflow
N8N_WEBHOOK_URL=https://your-n8n-instance.app/webhook/your-webhook-id

# Access code for users (temporary - replace with Stripe later)
ACCESS_CODE=your_secret_access_code

# Optional: Custom port (Railway will set this automatically)
PORT=8501
